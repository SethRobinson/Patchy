<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- patchy-gegl-host loads Patchy's own GEGL from Contents/Frameworks/gegl, and GEGL loads
	     its operation modules from there (docs/gegl-filters.md). make-dmg.sh signs them all with
	     Patchy's identity; this stays until a signed DMG shows the helper loads them without it. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Patchy points the helper at the bundle's lib folder with DYLD_LIBRARY_PATH (prepare_helper). -->
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
</dict>
</plist>
