<!doctype html>
<!-- Patchy web shell template. scripts\release\build-wasm.bat substitutes
     __PATCHY_VERSION__, __PATCHY_CACHE_TAG__, __PATCHY_WASM_SIZE__, and
     __PATCHY_WASM_SIZE_ST__ and stages the result as both patchy.html and
     index.html in build\package\wasm-site. The single-threaded st/ artifact is
     staged for manual Safari diagnostics, but automatic routing is disabled
     because current ST builds also die under workload (docs\wasm-memory.md).
     The ?v= query strings are the cache busters:
     every deploy gets a fresh tag, so browsers re-fetch changed assets while
     .htaccess lets tagged URLs cache forever. The page downloads patchy.wasm
     itself with a byte-counting reader (the Emscripten loader has no
     download-progress callback), compiles it with WebAssembly.compile, and
     hands the module to qtLoad via qt.module, so the fetched bytes can be
     garbage collected (passing wasmBinary instead would pin ~66 MB for the
     session's lifetime). The page also constructs the WebAssembly.Memory
     per device (see buildWasmMemory below and docs/wasm-memory.md).
     When the server answers Brotli/gzip (the .htaccess rewrite to the
     precompressed variants), the reader counts decompressed bytes while
     Content-Length reports compressed ones, so the baked-in uncompressed size
     is the progress total instead. -->
<html lang="en">
  <head>
    <meta charset="utf-8">
    <!-- 1:1 mapping between CSS pixels and Qt device independent pixels on mobile. -->
    <meta name="viewport" content="width=device-width, height=device-height, user-scalable=0"/>
    <title>Patchy Image Editor</title>
    <link rel="icon" type="image/x-icon" href="favicon.ico?v=__PATCHY_CACHE_TAG__">
    <link rel="apple-touch-icon" href="patchy-logo.png?v=__PATCHY_CACHE_TAG__">
    <style>
      html, body { padding: 0; margin: 0; overflow: hidden; height: 100%; background: #151a23; }
      #screen { width: 100%; height: 100%; display: none; }
      #loader {
        position: fixed; inset: 0; display: flex; flex-direction: column;
        align-items: center; justify-content: center; text-align: center;
        font-family: "Segoe UI", system-ui, -apple-system, sans-serif; color: #e8ebf1;
      }
      #loader img { width: 128px; height: 128px; margin-bottom: 18px; }
      #title { font-size: 30px; font-weight: 600; margin: 0; }
      #title span { font-size: 18px; font-weight: 400; color: #8f99ab; }
      .info { margin: 6px 0 26px; font-size: 14px; color: #8f99ab; }
      .info a { color: #5aa7f0; text-decoration: none; }
      .info a:hover { text-decoration: underline; }
      #bar { width: 340px; max-width: 78vw; height: 8px; border-radius: 4px; background: #2a3242; overflow: hidden; }
      #bar-fill {
        width: 0%; height: 100%; border-radius: 4px;
        background: linear-gradient(90deg, #57a9f2, #7fd9a6);
        transition: width .12s linear;
      }
      /* Unknown total (e.g. a compressed transfer hides the byte count): sweep instead. */
      .indeterminate #bar-fill { width: 30%; animation: sweep 1.1s ease-in-out infinite alternate; }
      @keyframes sweep { from { margin-left: 0; } to { margin-left: 70%; } }
      #status { margin-top: 12px; font-size: 13px; color: #8f99ab; min-height: 1.3em; }
      #status.error { color: #f07862; white-space: pre-wrap; max-width: 80vw; }
      #stnote {
        position: fixed; right: 14px; bottom: 14px; z-index: 10; max-width: 420px;
        background: #232b3a; color: #e8ebf1; border: 1px solid #3a4458; border-radius: 8px;
        padding: 14px 16px; font: 13px/1.5 "Segoe UI", system-ui, -apple-system, sans-serif;
        box-shadow: 0 6px 24px rgba(0, 0, 0, .45); display: none;
      }
      #stnote b { display: block; margin-bottom: 4px; }
      #stnote button { margin-top: 10px; padding: 6px 14px; }
    </style>
  </head>
  <body onload="init()">
    <div id="screen"></div>
    <div id="loader">
      <img src="patchy-logo.png?v=__PATCHY_CACHE_TAG__" alt="Patchy logo">
      <h1 id="title">Patchy <span>__PATCHY_VERSION__</span></h1>
      <p class="info">Free, open-source image editor &middot; <a href="https://www.rtsoft.com" target="_blank" rel="noopener">rtsoft.com</a> &middot; <a href="NOTICE-THIRD-PARTY.md" target="_blank" rel="noopener">Source &amp; licenses</a></p>
      <div id="bar"><div id="bar-fill"></div></div>
      <div id="status">Preparing...</div>
      <noscript>JavaScript is disabled. Please enable JavaScript to use Patchy.</noscript>
    </div>
    <div id="stnote">
      <b id="stnote-title"></b>
      <span id="stnote-text"></span>
      <br><button id="stnote-ok">OK</button>
    </div>

    <script type="text/javascript">
      const CACHE_TAG = '__PATCHY_CACHE_TAG__';

      // ---- Interface scale (browser-side) ----
      // The wasm platform plugin builds pointer events from raw DOM coordinates and
      // never converts them through Qt's high-DPI factor, so QT_SCALE_FACTOR renders
      // scaled but leaves every click offset. Scaling therefore happens here instead:
      // at any scale other than 100% the page re-embeds itself in an iframe that is
      // laid out larger and visually shrunk with a CSS transform. The browser maps
      // real input through the transform into the iframe's own coordinate space, so
      // inside the frame Qt runs at factor 1 with geometry, rendering, and input all
      // in one consistent coordinate space. The embedded copy also scales
      // devicePixelRatio so the canvas backing store lands 1:1 on device pixels.
      //
      // Keep the default and step list in sync with kDefaultGuiScalePercent and
      // kGuiScalePercents in src/ui/app_settings.hpp. The stored value is written by
      // the app through QSettings' localStorage backend; changing it in Preferences
      // takes effect on the next page load.
      const DEFAULT_SCALE_PERCENT = 75;
      const SCALE_PERCENTS = [67, 75, 90, 100, 125, 150, 175, 200];
      const SCALE_KEY_SUFFIX = 'preferences/guiScalePercent';

      function storedScalePercent() {
        try {
          for (let i = 0; i < localStorage.length; i++) {
            const key = localStorage.key(i);
            // Full key: qt-v0-Patchy-Patchy-preferences/guiScalePercent (see
            // qsettings_wasm.cpp); match on the suffix so the org/app prefix can
            // never drift out from under this page.
            if (key && key.indexOf('qt-v0-') === 0 && key.endsWith(SCALE_KEY_SUFFIX)) {
              const value = parseInt(localStorage.getItem(key), 10);
              if (SCALE_PERCENTS.indexOf(value) >= 0)
                return value;
            }
          }
        } catch (e) { /* storage blocked: fall through to the default */ }
        return DEFAULT_SCALE_PERCENT;
      }

      function embeddedScalePercent() {
        const value = parseInt(new URLSearchParams(location.search).get('embedded'), 10);
        return SCALE_PERCENTS.indexOf(value) >= 0 ? value : 0;
      }

      // Top-level page at a non-100% scale: replace the UI with the scaled iframe.
      function embedScaledApp(percent) {
        el('loader').style.display = 'none';
        const params = new URLSearchParams(location.search);
        params.set('embedded', String(percent));
        const frame = document.createElement('iframe');
        frame.id = 'scaled-app';
        frame.title = 'Patchy';
        frame.allow = 'fullscreen; clipboard-read; clipboard-write';
        const inverse = 10000 / percent; // 75% -> 133.33% layout, scaled to fit
        frame.style.cssText =
          'position:fixed;left:0;top:0;border:0;display:block;' +
          'width:' + inverse + '%;height:' + inverse + '%;' +
          'transform:scale(' + percent / 100 + ');transform-origin:0 0;';
        frame.src = location.pathname + '?' + params.toString();
        frame.addEventListener('load', () => { try { frame.contentWindow.focus(); } catch (e) {} });
        document.body.appendChild(frame);
      }

      // Embedded copy: report a devicePixelRatio scaled by the interface scale so the
      // backing store resolution matches the device pixels the transform maps onto
      // (12 logical px of text rasterizes into 12 * 0.75 * realDpr device px, crisp).
      // Input is unaffected; this only changes render resolution.
      function installScaledDevicePixelRatio(percent) {
        try {
          const desc = Object.getOwnPropertyDescriptor(window, 'devicePixelRatio') ||
                       Object.getOwnPropertyDescriptor(Window.prototype, 'devicePixelRatio');
          if (!desc || !desc.get)
            return;
          const realDpr = desc.get.bind(window);
          Object.defineProperty(window, 'devicePixelRatio', {
            configurable: true,
            get: () => realDpr() * (percent / 100),
          });
        } catch (e) { /* rendering stays at the unscaled dpr; input is unaffected */ }
      }
      // Uncompressed patchy.wasm size, baked in at staging time: the progress
      // total for encoded (br/gzip) responses, where the byte-counting reader
      // sees decompressed bytes but Content-Length carries the compressed
      // count. Falls back to the indeterminate sweep if it were ever 0.
      const WASM_SIZE = Number('__PATCHY_WASM_SIZE__') || 0;
      const WASM_SIZE_ST = Number('__PATCHY_WASM_SIZE_ST__') || 0;

      // ---- Wasm memory and threading (docs/wasm-memory.md, docs/wasm.md) ----
      // Tuning knobs for on-device experiments, all URL query params:
      //   ?PATCHY_WASM_INITIAL_MB=<n>  initial heap MB (floor: BAKED_MIN_MB)
      //   ?PATCHY_WASM_MAX_MB=<n>      heap ceiling MB (replaces the ladder)
      //   ?PATCHY_WASM_POOL=<n>        pthread pool size
      // The knobs survive the scale re-embed: embedScaledApp copies
      // location.search into the iframe URL.

      // patchy.js evaluates its pool-size formula on the main thread at load
      // and prefers globalThis.patchyPthreadPoolSize when set (see
      // QT_WASM_PTHREAD_POOL_SIZE in CMakeLists.txt). Perf-only knob: an
      // undersized pool degrades blocking fan-outs to sequential execution,
      // it does not deadlock (core/worker_budget clamps to the idle pool).
      (() => {
        const pool = parseInt(new URLSearchParams(location.search).get('PATCHY_WASM_POOL'), 10);
        if (Number.isFinite(pool) && pool > 0)
          globalThis.patchyPthreadPoolSize = pool;
      })();

      function isIosDevice() {
        // iPadOS 13+ reports platform "MacIntel" but is the only "Mac" with
        // multi-touch.
        return /iPad|iPhone|iPod/.test(navigator.userAgent)
            || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
      }

      // Safari's optimizing wasm compiler allocates unboundedly while
      // compiling the THREADED module and WebKit kills the tab within minutes
      // (measured; see docs/wasm-memory.md). The single-threaded artifact in
      // st/ is retained for manual comparisons, but current ST builds do not
      // survive a real workload either. Every iOS browser is WebKit regardless
      // of its name, and desktop Safari is the only desktop browser whose
      // vendor string is Apple's.
      // ?PATCHY_WASM_FORCE=st|mt overrides for testing (mt on Safari
      // reproduces the bug and retests future WebKit fixes).
      function isWebKitBrowser() {
        return isIosDevice() || navigator.vendor === 'Apple Computer, Inc.';
      }
      const FORCED_ARTIFACT = new URLSearchParams(location.search).get('PATCHY_WASM_FORCE');
      // Auto-routing stays OFF until an artifact that actually survives
      // Safari's compiler exists: measured August 2026, every
      // current-toolchain build, threaded or single-threaded and at every
      // optimization level, still dies under workload (docs/wasm-memory.md).
      // Flip this once a surviving st/ artifact ships.
      const AUTO_ROUTE_WEBKIT_TO_ST = false;
      const USE_ST = FORCED_ARTIFACT === 'st'
          || (AUTO_ROUTE_WEBKIT_TO_ST && FORCED_ARTIFACT !== 'mt' && isWebKitBrowser());
      const ARTIFACT_PREFIX = USE_ST ? 'st/' : '';

      // WebKit visitors get a notice after load. Two cases: the ST artifact
      // (compatibility mode; dismissed once, remembered forever) and the
      // stopgap warning while WebKit visitors still get the THREADED build
      // (the Safari 26 compiler bug can kill the tab within minutes, so the
      // warning returns each browser session rather than staying dismissed).
      function maybeShowSafariNotice() {
        let title;
        let text;
        let store;
        let key;
        if (USE_ST) {
          title = 'Running in Safari compatibility mode';
          text = 'A bug in Safari\'s WebAssembly optimizer can crash this tab, so Patchy is'
            + ' running in a slower single-threaded mode here. Heavy operations (large'
            + ' filters, big documents) may briefly freeze the display. For full speed,'
            + ' open Patchy in Chrome or Firefox on a desktop.';
          store = localStorage;
          key = 'patchySafariStNoticeDismissed';
        } else if (isWebKitBrowser()) {
          title = 'Safari warning';
          text = 'A bug in Safari\'s WebAssembly optimizer can make this tab run out of'
            + ' memory and close after a few minutes of use. Save your work often, and'
            + ' until the fix ships, Chrome, Firefox, or Edge on a desktop computer is'
            + ' recommended for Patchy.';
          store = sessionStorage;
          key = 'patchySafariMtWarningDismissed';
        } else {
          return;
        }
        try {
          if (store.getItem(key) === '1') return;
        } catch (e) { /* private mode: just show it */ }
        el('stnote-title').textContent = title;
        el('stnote-text').textContent = text;
        const note = el('stnote');
        note.style.display = 'block';
        el('stnote-ok').addEventListener('click', () => {
          note.style.display = 'none';
          // Give the keyboard back to Qt: a focused page button would
          // otherwise swallow every hotkey until the canvas is clicked.
          el('stnote-ok').blur();
          try { store.setItem(key, '1'); } catch (e) { /* ok */ }
        });
      }

      // The heap floor baked into the wasm memory import by
      // QT_WASM_INITIAL_MEMORY in CMakeLists.txt. Keep in sync: supplying a
      // memory with a smaller initial fails instantiation with a LinkError.
      const BAKED_MIN_MB = 256;

      // Constructs the shared WebAssembly.Memory the app runs in, choosing
      // initial size and ceiling per device. WebKit reserves a shared memory's
      // maximum up front; on iOS an oversized reservation either throws a
      // RangeError (caught here) or succeeds and gets the tab killed later by
      // the OS memory watchdog (uncatchable), so iOS starts low instead of
      // relying on the throw. Desktop tries the full 4 GB first, matching the
      // pre-ladder behavior on Chrome. Returns null when every rung fails.
      function buildWasmMemory() {
        const params = new URLSearchParams(location.search);
        const pagesPerMb = 16; // 64 KiB wasm pages
        const iOS = isIosDevice();
        const initialKnob = parseInt(params.get('PATCHY_WASM_INITIAL_MB'), 10);
        const initialMb = Math.max(BAKED_MIN_MB,
            (Number.isFinite(initialKnob) && initialKnob > 0) ? initialKnob : (iOS ? 256 : 512));
        const maxKnob = parseInt(params.get('PATCHY_WASM_MAX_MB'), 10);
        const ladder = (Number.isFinite(maxKnob) && maxKnob > 0)
            ? [Math.max(maxKnob, initialMb)]
            : (iOS ? [1536, 1024, 768] : [4096, 2048, 1024]).filter(mb => mb >= initialMb);
        for (const maxMb of ladder) {
          try {
            const memory = new WebAssembly.Memory(
                { initial: initialMb * pagesPerMb, maximum: maxMb * pagesPerMb, shared: true });
            // Read by the app for the About screen's memory readout
            // (Emscripten's own heap-max value is baked at link time and does
            // not reflect the ceiling chosen here).
            globalThis.patchyWasmMemoryMaximumBytes = maxMb * 1024 * 1024;
            console.info('Patchy wasm memory: initial=' + initialMb + 'MB max=' + maxMb
                + 'MB pool=' + (globalThis.patchyPthreadPoolSize || 'default'));
            return memory;
          } catch (e) {
            console.warn('WebAssembly.Memory with a ' + maxMb + ' MB maximum was refused; stepping down.', e);
          }
        }
        return null;
      }
      const el = id => document.getElementById(id);
      const formatMb = bytes => (bytes / (1024 * 1024)).toFixed(1);

      // patchy.js and qtloader.js come from the artifact set chosen above
      // (st/ for WebKit), so they are appended at runtime rather than as
      // static tags.
      function loadScript(src) {
        return new Promise((resolve, reject) => {
          const tag = document.createElement('script');
          tag.src = src;
          tag.onload = resolve;
          tag.onerror = () => reject(new Error('Failed to load ' + src));
          document.head.appendChild(tag);
        });
      }

      function setStatus(text) { el('status').textContent = text; }

      function showError(text) {
        const status = el('status');
        status.classList.add('error');
        status.textContent = text;
        el('bar').style.display = 'none';
      }

      function setProgress(received, total) {
        if (total > 0 && received <= total) {
          el('bar-fill').style.width = ((received / total) * 100).toFixed(1) + '%';
          setStatus('Downloading ' + formatMb(received) + ' of ' + formatMb(total) + ' MB');
        } else {
          el('loader').classList.add('indeterminate');
          setStatus('Downloading ' + formatMb(received) + ' MB');
        }
      }

      async function fetchWasmWithProgress(url, expectedSize) {
        const response = await fetch(url);
        if (!response.ok)
          throw new Error('Download failed: HTTP ' + response.status + ' for ' + url);
        const encoded = Boolean(response.headers.get('Content-Encoding'));
        const total = encoded
          ? expectedSize
          : (Number(response.headers.get('Content-Length') || 0) || expectedSize);
        if (!response.body)
          return new Uint8Array(await response.arrayBuffer());
        // One exact-size allocation streamed into directly: a chunk list plus
        // a final copy would hold two full copies (~130 MB) at its peak, and
        // that transient becomes permanent heap growth for the tab.
        const reader = response.body.getReader();
        let bytes = new Uint8Array(total > 0 ? total : 32 * 1024 * 1024);
        let received = 0;
        for (;;) {
          const { done, value } = await reader.read();
          if (done)
            break;
          if (received + value.length > bytes.length) {
            // Unknown or stale total (a broken deploy; the cache tag should
            // prevent it): grow by doubling.
            const grown = new Uint8Array(Math.max(bytes.length * 2, received + value.length));
            grown.set(bytes.subarray(0, received));
            bytes = grown;
          }
          bytes.set(value, received);
          received += value.length;
          setProgress(received, total);
        }
        return received === bytes.length ? bytes : bytes.subarray(0, received);
      }

      function showApp() {
        el('loader').style.display = 'none';
        el('screen').style.display = 'block';
      }

      function showExit(exitData) {
        el('screen').style.display = 'none';
        el('loader').style.display = 'flex';
        let message = exitData.crashed
          ? 'Patchy stopped unexpectedly' + (exitData.text ? ':\n' + exitData.text : '.')
          : 'Patchy exited' + (exitData.code !== undefined ? ' with code ' + exitData.code : '') + '.';
        // A malloc failure against the heap ceiling aborts with an
        // out-of-memory message that funnels here through qtloader's onAbort
        // wrapper; translate it for people who are not reading the console.
        if (exitData.crashed && /memor|enlarge|allocat|OOM|RangeError/i.test(exitData.text || '')) {
          const capMb = Math.round((globalThis.patchyWasmMemoryMaximumBytes || 0) / (1024 * 1024));
          message += '\nThe tab likely ran out of memory'
            + (capMb ? ' (heap limit ' + capMb + ' MB)' : '')
            + '. Smaller documents and fewer open images need less memory.';
        }
        showError(message + '\nReload the page to start again.');
      }

      async function init() {
        try {
          const embedded = embeddedScalePercent();
          if (embedded) {
            installScaledDevicePixelRatio(embedded);
          } else {
            const percent = storedScalePercent();
            if (percent !== 100) {
              embedScaledApp(percent);
              return; // The iframe copy of this page loads the app.
            }
          }
          let wasmMemory = null;
          if (!USE_ST) {
            // The multithreaded wasm build needs SharedArrayBuffer, which
            // browsers only enable on cross-origin isolated pages. The server
            // must send Cross-Origin-Opener-Policy: same-origin and
            // Cross-Origin-Embedder-Policy: require-corp (the staged
            // .htaccess does). Failing here beats the inscrutable
            // SharedArrayBuffer ReferenceError the loader would hit
            // otherwise. The single-threaded artifact needs neither the
            // isolation nor a page-built memory (its unshared memory import
            // rejects a shared one; Emscripten creates its own, and heap
            // growth needs no upfront reservation).
            if (!window.crossOriginIsolated) {
              showError('Patchy cannot start: this page is not cross-origin isolated.\n'
                + 'The server must send the Cross-Origin-Opener-Policy: same-origin and\n'
                + 'Cross-Origin-Embedder-Policy: require-corp response headers.');
              return;
            }
            // Reserve the memory before the download: if the device refuses
            // every ladder rung there is no point fetching 66 MB first. Only
            // this document (the iframe copy at non-100% scale) constructs a
            // memory; the outer page returned above, so the address-space
            // reservation is never doubled.
            wasmMemory = buildWasmMemory();
            if (!wasmMemory) {
              showError('Patchy cannot start: the browser refused to allocate its working memory.\n'
                + 'This device may be low on memory. Close other tabs and reload to try again.');
              return;
            }
          }
          setStatus('Contacting server...');
          // The loader scripts come from the chosen artifact set, so they
          // load here instead of static tags.
          await loadScript(ARTIFACT_PREFIX + 'patchy.js?v=' + CACHE_TAG);
          await loadScript(ARTIFACT_PREFIX + 'qtloader.js?v=' + CACHE_TAG);
          const wasmBytes = await fetchWasmWithProgress(
              ARTIFACT_PREFIX + 'patchy.wasm?v=' + CACHE_TAG,
              USE_ST ? WASM_SIZE_ST : WASM_SIZE);
          el('loader').classList.remove('indeterminate');
          el('bar-fill').style.width = '100%';
          setStatus('Starting Patchy...');
          // Compile here instead of passing wasmBinary: the compiled module is
          // what qtLoad and the pthread workers need, and the fetched bytes
          // become garbage collectable as soon as compile resolves.
          const wasmModule = await WebAssembly.compile(wasmBytes);
          const loadConfig = {
            locateFile: filename => ARTIFACT_PREFIX + filename + '?v=' + CACHE_TAG,
            qt: {
              module: Promise.resolve(wasmModule),
              onLoaded: () => { showApp(); maybeShowSafariNotice(); },
              onExit: showExit,
              entryFunction: window.patchy_entry,
              containerElements: [el('screen')],
            },
          };
          if (wasmMemory) {
            loadConfig.wasmMemory = wasmMemory;
          }
          await qtLoad(loadConfig);
        } catch (e) {
          console.error(e);
          showError('Patchy failed to load:\n' + (e && e.message ? e.message : e));
        }
      }
    </script>
  </body>
</html>
