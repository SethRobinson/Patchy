# The AppImage build environment (docs/appimage.md), built and run by
# packaging/linux/make-appimage.sh with rootless podman. Ubuntu 22.04 is the oldest distro the
# AppImage supports: everything is compiled against its glibc 2.35 and GCC 12 libstdc++
# (GLIBCXX_3.4.30), which every newer distro provides. Qt is the aqt 6.8.3 the Windows and
# macOS builds use (it needs only glibc 2.28). The build context is a scratch folder holding
# this file and scripts/setup-ai-deps.sh, never the repository.
FROM docker.io/library/ubuntu:22.04@sha256:5ec03bb3441e8b0bf3b4f9cd4629a1ae763010dc3035bb8da3ae6cf026486401

ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1

# x86_64 or aarch64: make-appimage.sh passes it with a matching `podman build --arch`, so
# the arm64 image runs natively on an arm64 host or under qemu-user-static elsewhere.
ARG ARCH=x86_64

# The compiler, MinGW-w64 for the Win32 plug-in helper Raven runs (docs/plugins.md, Linux), the headers Qt6Gui's CMake config needs, the runtime libraries the xcb and
# wayland platform plug-ins link (linuxdeploy resolves them here), the offscreen test fonts
# (tests/test_fonts.hpp), xvfb for windowed checks, and gettext's msgfmt for GEGL's catalogs.
RUN apt-get update && apt-get install -y --no-install-recommends \
      gcc-12 g++-12 ninja-build make binutils patchelf file git ca-certificates curl gettext \
      python3 python3-pip \
      libgl-dev libegl-dev libxkbcommon-dev libxkbcommon-x11-0 libfontconfig1 libfreetype6 \
      libdbus-1-3 libglib2.0-0 libcups2 \
      libxcb1 libx11-xcb1 libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
      libxcb-randr0 libxcb-render-util0 libxcb-shape0 libxcb-shm0 libxcb-sync1 \
      libxcb-xfixes0 libxcb-xinerama0 libxcb-xkb1 libxcb-glx0 libxcb-util1 \
      libsm6 libice6 libxext6 libxrender1 \
      libwayland-client0 libwayland-cursor0 libwayland-egl1 \
      desktop-file-utils xvfb xauth fonts-liberation fonts-dejavu-core locales \
      g++-mingw-w64-x86-64-posix \
    && rm -rf /var/lib/apt/lists/* \
    && locale-gen en_US.UTF-8

# A real locale, as on a desktop: under the C locale QCollator ignores numeric mode, so the
# natural-order tests (page-2 before page-10) cannot pass.
ENV LANG=en_US.UTF-8

# 22.04's apt CMake is 3.22; the project needs 3.26 (presets schema 6).
RUN pip3 install --no-cache-dir "cmake==3.31.6" "aqtinstall==3.3.0"

RUN if [ "$ARCH" = aarch64 ]; then \
      aqt install-qt linux_arm64 desktop 6.8.3 linux_gcc_arm64 -m qtimageformats qtpdf -O /opt/qt; \
    else \
      aqt install-qt linux desktop 6.8.3 linux_gcc_64 -m qtimageformats qtpdf -O /opt/qt; \
    fi

# ONNX Runtime and the segmentation models, pinned and checksummed by the same script the
# dev trees use (ends up in /opt/deps/onnxruntime/<version>/linux-x64 or linux-aarch64, and
# /opt/deps/ai-models).
COPY setup-ai-deps.sh /tmp/setup-ai-deps.sh
RUN bash /tmp/setup-ai-deps.sh /opt/deps && rm /tmp/setup-ai-deps.sh

# The packaging tools, pinned to release tags and checked against SHA-256 before use.
# linuxdeploy and its Qt plug-in collect the libraries; appimagetool packs the AppDir onto
# the static type2 runtime, which needs no libfuse2 on the user's machine.
RUN mkdir -p /opt/appimage-tools && cd /opt/appimage-tools \
    && curl -fL --retry 3 -o linuxdeploy-$ARCH.AppImage \
         https://github.com/linuxdeploy/linuxdeploy/releases/download/1-alpha-20251107-1/linuxdeploy-$ARCH.AppImage \
    && curl -fL --retry 3 -o linuxdeploy-plugin-qt-$ARCH.AppImage \
         https://github.com/linuxdeploy/linuxdeploy-plugin-qt/releases/download/1-alpha-20250213-1/linuxdeploy-plugin-qt-$ARCH.AppImage \
    && curl -fL --retry 3 -o appimagetool-$ARCH.AppImage \
         https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-$ARCH.AppImage \
    && curl -fL --retry 3 -o runtime-$ARCH \
         https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-$ARCH \
    && printf '%s\n' \
         "c20cd71e3a4e3b80c3483cef793cda3f4e990aca14014d23c544ca3ce1270b4d  linuxdeploy-x86_64.AppImage" \
         "15106be885c1c48a021198e7e1e9a48ce9d02a86dd0a1848f00bdbf3c1c92724  linuxdeploy-plugin-qt-x86_64.AppImage" \
         "ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0  appimagetool-x86_64.AppImage" \
         "2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d  runtime-x86_64" \
         "620095110d693282b8ebeb244a95b5e911cf8f65f76c88b4b47d16ae6346fcff  linuxdeploy-aarch64.AppImage" \
         "bf1c24aff6d749b5cf423afad6f15abd4440f81dec1aab95706b25f6667cdcf1  linuxdeploy-plugin-qt-aarch64.AppImage" \
         "f0837e7448a0c1e4e650a93bb3e85802546e60654ef287576f46c71c126a9158  appimagetool-aarch64.AppImage" \
         "00cbdfcf917cc6c0ff6d3347d59e0ca1f7f45a6df1a428a0d6d8a78664d87444  runtime-aarch64" \
       | grep -- "-$ARCH" | sha256sum -c - \
    && chmod +x linuxdeploy-$ARCH.AppImage linuxdeploy-plugin-qt-$ARCH.AppImage appimagetool-$ARCH.AppImage

# What scripts/dev/gegl/build-gegl-appimage.sh needs to build Patchy's own GEGL from source
# (docs/gegl-filters.md): GLib 2.84 wants Meson 1.4 or newer and Python's packaging module;
# GEGL's configure requires libjpeg and libpng for file loaders the bundle never ships.
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libffi-dev zlib1g-dev xz-utils \
      libjpeg-turbo8-dev libpng-dev \
    && rm -rf /var/lib/apt/lists/* \
    && pip3 install --no-cache-dir "meson==1.7.2" "packaging==24.2"

# No FUSE inside the container: the tool AppImages extract themselves to run.
ENV APPIMAGE_EXTRACT_AND_RUN=1
