{
  "format": 1,
  "name": "Example Package",
  "version": "1.1",
  "author": "RTsoft",
  "description": "The theme from Patchy's theme guide: a few colors, recolored icons, three icons of its own, a tiled backdrop, a sound when a save finishes, sparkles on new documents and a one-command script.",
  "base": "dark",
  "menuTitle": "Example",
  "recolorIcons": false,
  "iconScaling": "nearest",
  "backdrop": {
    "image": "images/backdrop.png",
    "mode": "tile"
  },
  "events": {
    "document-new": {
      "effect": "sparkles"
    }
  },
  "roles": {
    "accent": "#e0883a",
    "accent_pressed_bg": "#a85d1f",
    "accent_border_bright": "#f2a55c",
    "accent_checked_bg": "#a85d1f",
    "accent_checked_border": "#f2a55c",
    "layer_row_selected_bg": "#5c3d22",
    "layer_row_selected_border": "#c98545",
    "title_bar_bg": "#3b2a1c",
    "canvas_backdrop": "#1d2a2f",
    "canvas_scrollbar_track": "#1d2a2f",
    "icon_ink": "#f1dcc0",
    "icon_accent": "#f2a341"
  }
}
