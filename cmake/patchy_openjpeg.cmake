# Pinned, private JPEG 2000 codec: OpenJPEG 2.5.3's core library (src/lib/openjp2) as one
# static archive, built from the vendored sources in src/formats/openjpeg instead of
# upstream's CMake, so no tools, plug-ins, install rules or JPIP come along. The two
# configuration headers upstream generates at configure time are written here from the
# same facts (version, aligned-allocation and fseeko availability, little-endian hosts).
# Single-threaded: neither MUTEX_win32 nor MUTEX_pthread is defined, so thread.c compiles
# its no-op fallback and decoding stays deterministic (docs/hdr-formats.md,
# docs/legal-constraints.md for the licensing record).
function(patchy_add_openjpeg)
  set(root "${PROJECT_SOURCE_DIR}/src/formats/openjpeg")
  set(gen "${CMAKE_CURRENT_BINARY_DIR}/openjpeg-generated")
  file(MAKE_DIRECTORY "${gen}")
  patchy_write_if_different("${gen}/opj_config.h"
"#ifndef OPJ_CONFIG_H_INCLUDED
#define OPJ_CONFIG_H_INCLUDED
#define OPJ_VERSION_MAJOR 2
#define OPJ_VERSION_MINOR 5
#define OPJ_VERSION_BUILD 3
#endif
")
  set(private_lines "#define OPJ_PACKAGE_VERSION \"2.5.3\"\n")
  if(MSVC)
    string(APPEND private_lines "#define OPJ_HAVE_MALLOC_H\n#define OPJ_HAVE__ALIGNED_MALLOC\n")
  elseif(APPLE)
    string(APPEND private_lines "#define OPJ_HAVE_POSIX_MEMALIGN\n#define OPJ_HAVE_FSEEKO 1\n")
  else()
    string(APPEND private_lines "#define OPJ_HAVE_MALLOC_H\n#define OPJ_HAVE_POSIX_MEMALIGN\n#define OPJ_HAVE_FSEEKO 1\n")
  endif()
  patchy_write_if_different("${gen}/opj_config_private.h"
"/* Generated by cmake/patchy_openjpeg.cmake for the vendored OpenJPEG build. */
${private_lines}
#if !defined(_POSIX_C_SOURCE)
#if defined(OPJ_HAVE_FSEEKO) || defined(OPJ_HAVE_POSIX_MEMALIGN)
#define _POSIX_C_SOURCE 200112L
#endif
#endif
")

  file(GLOB sources "${root}/*.c")
  add_library(patchy_openjpeg STATIC ${sources})
  set_target_properties(patchy_openjpeg PROPERTIES C_STANDARD 99 C_STANDARD_REQUIRED ON POSITION_INDEPENDENT_CODE ON)
  target_include_directories(patchy_openjpeg PUBLIC "${root}" "${gen}")
  target_compile_definitions(patchy_openjpeg PUBLIC OPJ_STATIC)
  if(MSVC)
    target_compile_definitions(patchy_openjpeg PRIVATE _CRT_SECURE_NO_WARNINGS)
    target_compile_options(patchy_openjpeg PRIVATE /w)
  else()
    target_compile_options(patchy_openjpeg PRIVATE -w)
  endif()
  if(UNIX AND NOT APPLE AND NOT EMSCRIPTEN)
    target_link_libraries(patchy_openjpeg PUBLIC m)
  endif()
endfunction()

patchy_add_openjpeg()
