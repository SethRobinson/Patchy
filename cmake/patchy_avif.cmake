# Pinned, private AVIF stack: libavif 1.4.2 over the dav1d 1.5.4 AV1 decoder and the libaom
# 3.15.2 AV1 encoder, three static archives built from the vendored sources in
# src/formats/libavif, src/formats/dav1d and src/formats/libaom instead of upstream's CMake and
# meson, so no tools, tests, system codec discovery or install rules come along (docs/avif.md;
# licensing record in docs/legal-constraints.md).
#
# dav1d is compiled without assembly (HAVE_ASM 0): the portable C paths need no nasm, give
# the same bytes on every toolchain and are fast enough for stills. The bit-depth template
# sources are compiled twice (BITDEPTH 8 and 16) as meson does. config.h and vcs_version.h,
# which meson generates at configure time, are written here from the same facts.
#
# libaom is the encoder only (CONFIG_AV1_DECODER 0) for the generic CPU target: no SIMD, no
# nasm, no perl at build time. Its source list and the arch-independent rtcd headers were
# harvested once from upstream's configure (src/formats/libaom/patchy-config); aom_config.h is
# written here per OS. libavif gets codec_dav1d.c for decoding and codec_aom.c for encoding.
# Scaling of grid tiles uses the small libyuv subset upstream bundles for builds without a
# system libyuv.
function(patchy_add_avif)
  set(dav1d_root "${PROJECT_SOURCE_DIR}/src/formats/dav1d")
  set(avif_root "${PROJECT_SOURCE_DIR}/src/formats/libavif")
  set(gen "${CMAKE_CURRENT_BINARY_DIR}/dav1d-generated")
  file(MAKE_DIRECTORY "${gen}")

  # The portable build: every arch and assembler fact is 0 so the C DSP paths compile and
  # the asm headers are never included. Alignment stays conservative on every target.
  set(config_lines "")
  foreach(name ARCH_AARCH64 ARCH_ARM ARCH_PPC64LE ARCH_RISCV ARCH_RV32 ARCH_RV64 ARCH_LOONGARCH
      ARCH_LOONGARCH32 ARCH_LOONGARCH64 ARCH_X86 ARCH_X86_32 ARCH_X86_64 HAVE_ASM HAVE_AS_FUNC
      HAVE_AS_ARCH_DIRECTIVE HAVE_DOTPROD HAVE_I8MM HAVE_SVE HAVE_SVE2 HAVE_GETAUXVAL HAVE_ELF_AUX_INFO
      HAVE_DLSYM TRIM_DSP_FUNCTIONS ENDIANNESS_BIG)
    string(APPEND config_lines "#define ${name} 0\n")
  endforeach()
  string(APPEND config_lines "#define CONFIG_8BPC 1\n#define CONFIG_16BPC 1\n#define CONFIG_LOG 0\n")
  if(WIN32)
    string(APPEND config_lines
      "#define _WIN32_WINNT 0x0601\n#define UNICODE 1\n#define _UNICODE 1\n"
      "#define _CRT_DECLARE_NONSTDC_NAMES 1\n#define HAVE_IO_H 1\n#define HAVE_UNISTD_H 0\n"
      "#define HAVE_SYS_TYPES_H 1\n#define HAVE_CLOCK_GETTIME 0\n#define HAVE_SIGACTION 0\n"
      "#define HAVE_POSIX_MEMALIGN 0\n#define HAVE_MEMALIGN 0\n#define HAVE_ALIGNED_ALLOC 0\n"
      "#define HAVE_PTHREAD_NP_H 0\n#define HAVE_PTHREAD_GETAFFINITY_NP 0\n"
      "#define HAVE_PTHREAD_SETAFFINITY_NP 0\n#define HAVE_PTHREAD_SETNAME_NP 0\n"
      "#define HAVE_PTHREAD_SET_NAME_NP 0\n")
  else()
    string(APPEND config_lines
      "#define HAVE_IO_H 0\n#define HAVE_UNISTD_H 1\n#define HAVE_SYS_TYPES_H 1\n"
      "#define HAVE_CLOCK_GETTIME 1\n#define HAVE_SIGACTION 1\n#define HAVE_POSIX_MEMALIGN 1\n"
      "#define HAVE_ALIGNED_ALLOC 0\n#define HAVE_PTHREAD_NP_H 0\n#define HAVE_PTHREAD_SET_NAME_NP 0\n")
    if(APPLE)
      string(APPEND config_lines
        "#define HAVE_MEMALIGN 0\n#define HAVE_PTHREAD_GETAFFINITY_NP 0\n"
        "#define HAVE_PTHREAD_SETAFFINITY_NP 0\n#define HAVE_PTHREAD_SETNAME_NP 1\n")
    else()
      string(APPEND config_lines
        "#define HAVE_MEMALIGN 1\n#define HAVE_PTHREAD_GETAFFINITY_NP 1\n"
        "#define HAVE_PTHREAD_SETAFFINITY_NP 1\n#define HAVE_PTHREAD_SETNAME_NP 1\n")
    endif()
  endif()
  patchy_write_if_different("${gen}/config.h"
"/* Generated by cmake/patchy_avif.cmake for the vendored dav1d build. */
#pragma once
${config_lines}")
  patchy_write_if_different("${gen}/vcs_version.h" "/* auto-generated, do not edit */\n#define DAV1D_VERSION \"1.5.4\"\n")

  set(dav1d_sources)
  foreach(item cdf cpu ctx data decode dequant_tables getbits intra_edge itx_1d lf_mask lib log mem
      msac obu pal picture qm ref refmvs scan tables thread_task warpmv wedge)
    list(APPEND dav1d_sources "${dav1d_root}/src/${item}.c")
  endforeach()
  if(WIN32)
    list(APPEND dav1d_sources "${dav1d_root}/src/win32/thread.c")
  endif()
  set(dav1d_template_sources)
  foreach(item cdef_apply cdef fg_apply filmgrain ipred_prepare ipred itx lf_apply loopfilter
      looprestoration lr_apply mc recon)
    list(APPEND dav1d_template_sources "${dav1d_root}/src/${item}_tmpl.c")
  endforeach()

  set(dav1d_includes "${dav1d_root}" "${dav1d_root}/include" "${dav1d_root}/include/dav1d" "${gen}")
  if(MSVC)
    # MSVC's own <stdatomic.h> needs an experimental switch in C; dav1d's shim wraps the
    # Interlocked* intrinsics instead (meson picks it the same way).
    list(PREPEND dav1d_includes "${dav1d_root}/include/compat/msvc")
  endif()

  foreach(bitdepth 8 16)
    add_library(patchy_dav1d_${bitdepth}bpc OBJECT ${dav1d_template_sources})
    target_compile_definitions(patchy_dav1d_${bitdepth}bpc PRIVATE BITDEPTH=${bitdepth})
    target_include_directories(patchy_dav1d_${bitdepth}bpc PRIVATE ${dav1d_includes})
  endforeach()
  add_library(patchy_dav1d STATIC ${dav1d_sources}
    $<TARGET_OBJECTS:patchy_dav1d_8bpc> $<TARGET_OBJECTS:patchy_dav1d_16bpc>)
  target_include_directories(patchy_dav1d PUBLIC "${dav1d_root}/include" PRIVATE ${dav1d_includes})
  foreach(target patchy_dav1d patchy_dav1d_8bpc patchy_dav1d_16bpc)
    set_target_properties(${target} PROPERTIES C_STANDARD 99 C_STANDARD_REQUIRED ON POSITION_INDEPENDENT_CODE ON)
    if(MSVC)
      target_compile_definitions(${target} PRIVATE _CRT_SECURE_NO_WARNINGS)
      target_compile_options(${target} PRIVATE /w)
    else()
      target_compile_options(${target} PRIVATE -w -fvisibility=hidden)
      if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        target_compile_definitions(${target} PRIVATE _GNU_SOURCE)
      endif()
    endif()
  endforeach()
  if(NOT WIN32)
    find_package(Threads REQUIRED)
    target_link_libraries(patchy_dav1d PUBLIC Threads::Threads)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
      target_link_libraries(patchy_dav1d PUBLIC m)
    endif()
  endif()

  # libaom: encoder only, generic CPU.
  set(aom_root "${PROJECT_SOURCE_DIR}/src/formats/libaom")
  set(aom_gen "${CMAKE_CURRENT_BINARY_DIR}/libaom-generated")
  file(MAKE_DIRECTORY "${aom_gen}/config")
  include("${aom_root}/patchy-config/sources.cmake")
  set(aom_sources)
  foreach(item IN LISTS PATCHY_AOM_SOURCES)
    list(APPEND aom_sources "${aom_root}/${item}")
  endforeach()
  set(aom_config_lines "")
  foreach(name AOM_ARCH_AARCH64 AOM_ARCH_ARM AOM_ARCH_PPC AOM_ARCH_RISCV AOM_ARCH_X86 AOM_ARCH_X86_64
      CONFIG_ACCOUNTING CONFIG_ANALYZER CONFIG_AV1_DECODER CONFIG_AV1_TEMPORAL_DENOISING CONFIG_BIG_ENDIAN
      CONFIG_BITRATE_ACCURACY CONFIG_BITRATE_ACCURACY_BL CONFIG_BITSTREAM_DEBUG CONFIG_COEFFICIENT_RANGE_CHECKING
      CONFIG_COLLECT_COMPONENT_TIMING CONFIG_COLLECT_PARTITION_STATS CONFIG_COLLECT_RD_STATS CONFIG_CWG_C013
      CONFIG_CWG_E050 CONFIG_DEBUG CONFIG_ENTROPY_STATS CONFIG_EXCLUDE_SIMD_MISMATCH CONFIG_FPMT_TEST CONFIG_GCOV
      CONFIG_GPROF CONFIG_HIGHWAY CONFIG_INSPECTION CONFIG_INTERNAL_STATS CONFIG_INTER_STATS_ONLY CONFIG_LIBYUV
      CONFIG_MISMATCH_DEBUG CONFIG_NN_V2 CONFIG_NORMAL_TILE_MODE CONFIG_OPTICAL_FLOW_API CONFIG_OUTPUT_FRAME_SIZE
      CONFIG_PARTITION_SEARCH_ORDER CONFIG_PIC CONFIG_RATECTRL_LOG CONFIG_RD_COMMAND CONFIG_RD_DEBUG
      CONFIG_REALTIME_ONLY CONFIG_RT_ML_PARTITIONING CONFIG_SALIENCY_MAP CONFIG_SHARED CONFIG_SIZE_LIMIT
      CONFIG_SPEED_STATS CONFIG_TFLITE CONFIG_THREE_PASS CONFIG_TUNE_BUTTERAUGLI CONFIG_TUNE_VMAF CONFIG_WEBM_IO
      DECODE_HEIGHT_LIMIT DECODE_WIDTH_LIMIT FORCE_HIGHBITDEPTH_DECODING HAVE_ARM_CRC32 HAVE_AVX HAVE_AVX2
      HAVE_AVX512 HAVE_FEXCEPT HAVE_MMX HAVE_NEON HAVE_NEON_DOTPROD HAVE_NEON_I8MM HAVE_RVV HAVE_SSE HAVE_SSE2
      HAVE_SSE3 HAVE_SSE4_1 HAVE_SSE4_2 HAVE_SSSE3 HAVE_SVE HAVE_SVE2 HAVE_VSX HAVE_WXWIDGETS STATIC_LINK_JXL)
    string(APPEND aom_config_lines "#define ${name} 0
")
  endforeach()
  foreach(name CONFIG_AV1_ENCODER CONFIG_AV1_HIGHBITDEPTH CONFIG_DENOISE CONFIG_DISABLE_FULL_PIXEL_SPLIT_8X8
      CONFIG_LIBVMAF_PSNR_PEAK CONFIG_MULTITHREAD CONFIG_OS_SUPPORT CONFIG_QUANT_MATRIX CONFIG_RUNTIME_CPU_DETECT)
    string(APPEND aom_config_lines "#define ${name} 1
")
  endforeach()
  string(APPEND aom_config_lines "#define CONFIG_MAX_DECODE_PROFILE 2
")
  if(MSVC)
    # Windows threads through aom_util/aom_pthread.h's shim.
    string(APPEND aom_config_lines
      "#define CONFIG_GCC 0
#define HAVE_PTHREAD_H 0
#define HAVE_PTHREAD_SETNAME_NP 0
#define HAVE_UNISTD_H 0
")
  else()
    string(APPEND aom_config_lines
      "#define CONFIG_GCC 1
#define HAVE_PTHREAD_H 1
#define HAVE_PTHREAD_SETNAME_NP 1
#define HAVE_UNISTD_H 1
")
  endif()
  patchy_write_if_different("${aom_gen}/config/aom_config.h"
"/* Generated by cmake/patchy_avif.cmake for the vendored libaom build (generic CPU, encoder only). */
#ifndef AOM_CONFIG_H_
#define AOM_CONFIG_H_
${aom_config_lines}#endif  // AOM_CONFIG_H_
")
  patchy_write_if_different("${aom_gen}/config/aom_config.c"
"#include \"aom/aom_codec.h\"
static const char* const cfg = \"patchy vendored libaom 3.15.2: generic cpu, encoder only, no simd\";
const char *aom_codec_build_config(void) { return cfg; }
")
  add_library(patchy_aom STATIC ${aom_sources} "${aom_gen}/config/aom_config.c")
  # Upstream builds libaom as C11 (static_assert in av1/common); MSVC's assert.h provides it in
  # its default mode, so only the other compilers get the standard switch.
  set_target_properties(patchy_aom PROPERTIES C_STANDARD_REQUIRED ON POSITION_INDEPENDENT_CODE ON)
  if(MSVC)
    set_target_properties(patchy_aom PROPERTIES C_STANDARD 99)
  else()
    set_target_properties(patchy_aom PROPERTIES C_STANDARD 11)
  endif()
  target_include_directories(patchy_aom
    PUBLIC "${aom_root}"
    PRIVATE "${aom_root}/patchy-config" "${aom_gen}")
  if(MSVC)
    target_compile_definitions(patchy_aom PRIVATE _CRT_SECURE_NO_WARNINGS NOMINMAX)
    target_compile_options(patchy_aom PRIVATE /w)
  else()
    target_compile_definitions(patchy_aom PRIVATE _LARGEFILE_SOURCE _FILE_OFFSET_BITS=64)
    target_compile_options(patchy_aom PRIVATE -w -fvisibility=hidden)
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
      target_compile_definitions(patchy_aom PRIVATE _GNU_SOURCE)
    endif()
    find_package(Threads REQUIRED)
    target_link_libraries(patchy_aom PUBLIC Threads::Threads)
  endif()
  if(UNIX AND NOT APPLE)
    target_link_libraries(patchy_aom PUBLIC m)
  endif()

  file(GLOB avif_sources "${avif_root}/src/*.c")
  file(GLOB libyuv_sources "${avif_root}/third_party/libyuv/source/*.c")
  add_library(patchy_avif STATIC ${avif_sources} ${libyuv_sources})
  # libavif is C11 (static_assert in io.c; upstream sets C_STANDARD 11).
  set_target_properties(patchy_avif PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED ON POSITION_INDEPENDENT_CODE ON)
  target_include_directories(patchy_avif
    PUBLIC "${avif_root}/include"
    PRIVATE "${avif_root}/third_party/libyuv/include")
  # dav1d decodes, libaom encodes (no AVIF_CODEC_AOM_DECODE: avifDecoder never sees libaom).
  target_compile_definitions(patchy_avif PRIVATE AVIF_CODEC_DAV1D=1 AVIF_CODEC_AOM=1 AVIF_CODEC_AOM_ENCODE=1)
  target_link_libraries(patchy_avif PUBLIC patchy_dav1d patchy_aom)
  if(MSVC)
    target_compile_definitions(patchy_avif PRIVATE _CRT_SECURE_NO_WARNINGS _CRT_NONSTDC_NO_WARNINGS)
    target_compile_options(patchy_avif PRIVATE /w)
  else()
    target_compile_options(patchy_avif PRIVATE -w -fvisibility=hidden)
  endif()
  if(UNIX AND NOT APPLE)
    target_link_libraries(patchy_avif PUBLIC m)
  endif()
endfunction()

patchy_add_avif()
