#pragma once

// Generated by configure_file from cmake/patchy_version.hpp.in at configure
// time; never edit or commit the generated copy. The version used to be a
// target-wide compile definition, which made every version bump recompile
// all of patchy_ui: Ninja treats a changed command line as a changed input.
// As a header, only the few translation units that include it rebuild.
#define PATCHY_VERSION "@PROJECT_VERSION@"
