#include <winver.h>

1 ICON "@PROJECT_SOURCE_DIR@/src/app/patchy.ico"

1 VERSIONINFO
FILEVERSION @PATCHY_WINDOWS_VERSION@
PRODUCTVERSION @PATCHY_WINDOWS_VERSION@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RTsoft\0"
            VALUE "FileDescription", "Patchy Image Editor\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "patchy\0"
            VALUE "OriginalFilename", "patchy.exe\0"
            VALUE "ProductName", "Patchy\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
